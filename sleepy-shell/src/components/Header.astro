---
const navItems = [
  { label: "Home", href: "/" },
  { label: "Publications", href: "/publications" },
  { label: "Reports", href: "/reports" },
  { label: "Sauces", href: "/sauces" },
  { label: "Garden", href: "https://mvallet91.github.io/garden/", external: true }
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white/80 backdrop-blur-lg shadow-sm">
  <nav class="container mx-auto px-6 py-3 flex justify-between items-center">
      <a href="/" class="text-xl font-bold text-cyan-800">
        Manuel Valle Torre
      </a>
      <div class="hidden md:flex space-x-8">
        {navItems.map(item => (
          <a 
            href={item.href}
            target={item.external ? "_blank" : undefined}
            rel={item.external ? "noopener noreferrer" : undefined}
            class:list={[
              "nav-link text-gray-600 border-b-2 border-transparent pb-1",
              "hover:text-cyan-800 hover:border-cyan-800",
               currentPath === item.href && "active text-cyan-800 border-cyan-800"
            ]}
          >
            {item.label}
          </a>
        ))}
      </div>
    </nav>
</header>
