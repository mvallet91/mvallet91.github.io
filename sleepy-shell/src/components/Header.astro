---
const navItems = [
  { label: "Home", href: "/" },
  { label: "Publications", href: "/publications" },
  { label: "Reports", href: "/reports" },
  { label: "Sauces", href: "/sauces" },
  { label: "GitHub", href: "https://github.com/mvallet91/", external: true }
];

const currentPath = Astro.url.pathname;
---

<header class="border-b-4 border-black dark:border-white bg-white dark:bg-gray-900">
  <nav class="container mx-auto px-6 py-4 flex flex-col md:flex-row justify-between items-center gap-4">
      <a href="/" class="text-3xl font-analog-serif font-black text-black dark:text-white tracking-tight hover:underline decoration-2 underline-offset-4">
        MVT.
      </a>
      <div class="flex flex-wrap justify-center gap-6 md:gap-8">
        {navItems.map(item => (
          <a 
            href={item.href}
            target={item.external ? "_blank" : undefined}
            rel={item.external ? "noopener noreferrer" : undefined}
            class:list={[
              "font-analog-mono text-sm font-bold uppercase tracking-wider text-gray-400 hover:text-black dark:hover:text-white transition-colors",
              currentPath.startsWith(item.href) && item.href !== '/' ? "text-black dark:text-white underline decoration-2 underline-offset-4" : "",
              currentPath === item.href ? "text-black dark:text-white underline decoration-2 underline-offset-4" : ""
            ]}
          >
            [{item.label}]
          </a>
        ))}
      </div>
    </nav>
</header>
