---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

const reports = [
  {
    title: 'AI in Education: The Missing Link',
    summary:
      'An interactive deep-dive on why Learning Analytics is the missing ingredient for meaningful Generative AI deployments in education.',
    href: '/reports/ai-in-education/',
    tags: ['Generative AI', 'Learning Analytics', 'Interactive'],
    cta: 'Read the interactive report'
  },
  {
    title: 'JELAI: Integrating AI and Learning Analytics in Jupyter Notebooks',
    summary:
      'Explore how JELAI pairs LLM tutoring with fine-grained telemetry inside Jupyter to deliver context-aware support and research-ready data.',
    href: '/reports/jelai/',
    tags: ['Learning Analytics', 'Jupyter', 'LLMs'],
    cta: 'Dive into the architecture'
  }
];
---

<Layout
  title="Reports | Manuel Valle Torre"
  description="Interactive reports on Learning Analytics, Generative AI, and education."
>
  <Header />

  <main class="space-y-12">
    <section class="space-y-4">
      <h1 class="text-4xl font-bold text-gray-900 dark:text-white">Reports</h1>
      <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl">
        Occasionally I package research notes, experiments, and provocations into more interactive formats.
        These reports mix narrative, data visualisations, and design explorations to explain how we can use
        Learning Analytics and AI responsibly in education.
      </p>
    </section>

    <section class="grid gap-8">
      {reports.map((report) => (
        <article class="rounded-2xl border border-gray-200 dark:border-gray-700 bg-white/80 dark:bg-gray-900/60 shadow-sm hover:shadow-lg transition-shadow duration-300 overflow-hidden">
          <div class="p-8 space-y-4">
            <div class="flex flex-wrap gap-2 text-sm text-accent">
              {report.tags.map((tag) => (
                <span class="px-3 py-1 rounded-full bg-accent/10 text-accent dark:text-accent-dark">
                  {tag}
                </span>
              ))}
            </div>
            <h2 class="text-2xl font-semibold text-gray-900 dark:text-white">
              {report.title}
            </h2>
            <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
              {report.summary}
            </p>
            <a
              href={report.href}
              class="inline-flex items-center gap-2 font-medium text-accent hover:text-accent-dark transition-colors"
            >
              {report.cta}
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </article>
      ))}
    </section>
  </main>
</Layout>
