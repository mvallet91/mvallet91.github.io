---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout 
  title="Sequence Matters - Dashboard"
  description="Interactive dashboard of learning sequence articles."
>
  <Header slot="header" />
  
  <main class="max-w-[95vw] mx-auto px-4 py-8">
    <div class="mb-8">
        <h1 class="text-4xl font-analog-serif font-black mb-4">Sequence Matters Review</h1>
        <p class="font-analog-serif max-w-prose mb-4">
            Interactive dashboard for the Learning Sequences Review. Select columns to visualize their specific distributions and relationships.
        </p>
    </div>

    <!-- Controls / Filters -->
    <div class="mb-4 bg-[#fffefa] dark:bg-[#2c2621] p-4 border border-[#d8cec3] dark:border-[#66584d] shadow-sm">
        <h3 class="font-analog-mono text-sm font-bold uppercase mb-2">Column Selection (for Visualization)</h3>
        <div id="column-selector" class="flex flex-wrap gap-2 text-sm font-analog-mono">
            <!-- Checkboxes will be injected here -->
        </div>
    </div>

    <!-- Charts Area -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
        <!-- Parcats (Sankey-like) -->
        <div class="lg:col-span-2 bg-[#fffefa] dark:bg-[#2c2621] border border-[#d8cec3] dark:border-[#66584d] p-2 shadow-sm min-h-[400px]">
            <div id="parcats-chart" class="w-full h-[500px]"></div>
        </div>

        <!-- Bar Charts Container -->
        <div id="bar-charts-container" class="space-y-4 max-h-[500px] overflow-y-auto">
            <!-- Bar charts injected here -->
        </div>
    </div>

    <!-- Data Table -->
    <div class="overflow-x-auto bg-[#fffefa] dark:bg-[#2c2621] border border-[#d8cec3] dark:border-[#66584d] shadow-sm">
        <table id="data-table" class="w-full text-sm text-left border-collapse">
            <thead class="bg-[#f4eee6] dark:bg-[#382f28] font-analog-mono text-xs uppercase sticky top-0">
                <!-- Headers injected here -->
            </thead>
            <thead class="bg-[#fffefa] dark:bg-[#2c2621] sticky top-0" id="filter-row">
                <!-- Filter inputs injected here -->
            </thead>
            <tbody class="divide-y divide-[#d8cec3] dark:divide-[#66584d]">
                <!-- Rows injected here -->
            </tbody>
        </table>
    </div>

  </main>
</Layout>

<script>
    import Plotly from 'plotly.js-dist-min';

    let rawData = [];
    let selectedColumns = ['Domain', 'Task']; // Default selection matches app.py

    async function init() {
        try {
            const response = await fetch('/data/articles.json');
            rawData = await response.json();
            
            if (rawData.length === 0) return;

            renderColumnSelector();
            renderTable();
            updateCharts();
        } catch (e) {
            console.error("Failed to load data:", e);
        }
    }

    // --- Rendering Controls ---
    function renderColumnSelector() {
        const container = document.getElementById('column-selector');
        const columns = Object.keys(rawData[0]);
        
        container.innerHTML = '';
        columns.forEach(col => {
            if (col === 'Cite') return; // Skip Cite for viz as per app.py logic roughly

            const label = document.createElement('label');
            label.className = "flex items-center gap-1 cursor-pointer bg-[#f4eee6] dark:bg-[#382f28] px-2 py-1 border border-[#d8cec3] dark:border-[#66584d] hover:bg-[#ffedd5] dark:hover:bg-[#5b301d]";
            
            const input = document.createElement('input');
            input.type = "checkbox";
            input.value = col;
            input.checked = selectedColumns.includes(col);
            input.className = "accent-orange-700 dark:accent-orange-300";
            
            input.addEventListener('change', (e) => {
                if (e.target.checked) {
                    if (!selectedColumns.includes(col)) selectedColumns.push(col);
                } else {
                    selectedColumns = selectedColumns.filter(c => c !== col);
                }
                updateCharts();
            });

            label.appendChild(input);
            label.appendChild(document.createTextNode(col));
            container.appendChild(label);
        });
    }

    // --- Rendering Table ---
    let columnFilters = {}; // Track filter values per column

    function renderTable() {
        const tableHead = document.querySelector('#data-table thead');
        const filterRow = document.getElementById('filter-row');
        const tableBody = document.querySelector('#data-table tbody');
        const columns = Object.keys(rawData[0]);

        // Headers
        let headerRow = '<tr>';
        columns.forEach(col => {
            const widthStyle = col === 'Cite' ? 'width: 20%; min-width: 200px;' : '';
            headerRow += `<th class="px-4 py-2 border-b border-[#d8cec3] dark:border-[#66584d] truncate" style="${widthStyle}" title="${col}">${col}</th>`;
        });
        headerRow += '</tr>';
        tableHead.innerHTML = headerRow;

        // Filter Row
        let filterHtml = '<tr>';
        columns.forEach(col => {
            filterHtml += `<th class="px-2 py-1 border-b border-[#d8cec3] dark:border-[#66584d]">
                <input 
                    type="text" 
                    placeholder="Filter..." 
                    class="w-full px-2 py-1 text-xs border border-[#d8cec3] dark:border-[#66584d] focus:border-[#9a3412] dark:focus:border-[#fdba74] focus:outline-none font-mono bg-[#fffefa] dark:bg-[#211d1a]"
                    data-column="${col}"
                    id="filter-${col.replace(/\s+/g, '-')}"
                />
            </th>`;
        });
        filterHtml += '</tr>';
        filterRow.innerHTML = filterHtml;

        // Add event listeners to filter inputs
        columns.forEach(col => {
            const input = document.getElementById(`filter-${col.replace(/\s+/g, '-')}`);
            input.addEventListener('input', (e) => {
                columnFilters[col] = e.target.value.toLowerCase();
                filterTableRows();
            });
        });

        // Initial render
        renderTableRows();
    }

    function renderTableRows() {
        const tableBody = document.querySelector('#data-table tbody');
        const columns = Object.keys(rawData[0]);
        
        let bodyHtml = '';
        rawData.forEach((row, idx) => {
            bodyHtml += `<tr class="hover:bg-orange-50/70 dark:hover:bg-orange-950/30 transition-colors" data-row-index="${idx}">`;
            columns.forEach(col => {
                let val = row[col] || '';
                if (col === 'Cite') {
                    bodyHtml += `<td class="px-4 py-2 whitespace-normal align-top text-xs">${val}</td>`;
                } else {
                    bodyHtml += `<td class="px-4 py-2 whitespace-nowrap align-top">${val}</td>`;
                }
            });
            bodyHtml += `</tr>`;
        });
        tableBody.innerHTML = bodyHtml;
    }

    function filterTableRows() {
        const rows = document.querySelectorAll('#data-table tbody tr');
        
        rows.forEach(row => {
            const rowIndex = parseInt(row.getAttribute('data-row-index'));
            const rowData = rawData[rowIndex];
            let show = true;

            // Check all active filters
            for (const [col, filterValue] of Object.entries(columnFilters)) {
                if (filterValue && filterValue.trim() !== '') {
                    const cellValue = (rowData[col] || '').toString().toLowerCase();
                    if (!cellValue.includes(filterValue)) {
                        show = false;
                        break;
                    }
                }
            }

            row.style.display = show ? '' : 'none';
        });
    }

    // --- Rendering Charts ---
    function updateCharts() {
        updateBarCharts();
        updateParcats();
    }

    function updateBarCharts() {
        const container = document.getElementById('bar-charts-container');
        container.innerHTML = ''; // Clear existing

        selectedColumns.forEach(imgCol => {
            if (!rawData[0].hasOwnProperty(imgCol)) return;

            // Calculate value counts
            const counts = {};
            rawData.forEach(r => {
                const val = r[imgCol];
                counts[val] = (counts[val] || 0) + 1;
            });

            // Sort by count descending
            const sortedKeys = Object.keys(counts).sort((a, b) => counts[b] - counts[a]);
            const xVal = sortedKeys;
            const yVal = sortedKeys.map(k => counts[k]);

            const wrapper = document.createElement('div');
            wrapper.className = "bg-[#fffefa] dark:bg-[#2c2621] border border-[#d8cec3] dark:border-[#66584d] p-2 shadow-sm";
            const divId = `bar-${imgCol.replace(/\s+/g, '-')}`;
            wrapper.innerHTML = `<h4 class="font-analog-mono text-xs font-bold mb-1 border-b border-[#d8cec3] dark:border-[#66584d] pb-1">${imgCol}</h4><div id="${divId}" style="height: 200px;"></div>`;
            container.appendChild(wrapper);

            const theme = getThemeColors();
            Plotly.newPlot(divId, [{
                x: xVal,
                y: yVal,
                type: 'bar',
                marker: { color: theme.accent }
            }], {
                margin: { t: 10, l: 30, r: 10, b: 60 },
                paper_bgcolor: theme.surface,
                plot_bgcolor: theme.surface,
                font: { color: theme.text, family: 'serif' },
                xaxis: { title: { text: '' }, automargin: true, gridcolor: theme.line, tickfont: { color: theme.text } },
                yaxis: { title: { text: '' }, automargin: true, gridcolor: theme.line, tickfont: { color: theme.text } }
            }, { responsive: true, displayModeBar: false });
        });
    }

    function updateParcats() {
        if (selectedColumns.length < 2) {
            Plotly.purge('parcats-chart');
            return;
        }

        // Prepare dimensions
        const dimensions = selectedColumns.map(col => {
            return {
                label: col,
                values: rawData.map(r => r[col])
            };
        });

        // Basic coloring - just solid for now or attempting to replicate the 'active cell' logic is too complex for static without heavy state.
        // We'll use a simple color scale based on the first selected column or just index.
        const colorVal = new Array(rawData.length).fill(0).map((_, i) => i / rawData.length); // Gradient

        const theme = getThemeColors();
        const data = [{
            type: 'parcats',
            dimensions: dimensions,
            line: {
                color: colorVal,
                colorscale: theme.isDark ? 'Oranges' : 'Blues',
                shape: 'hspline'
            },
            labelfont: { size: 14, family: 'serif' },
            tickfont: { size: 12, family: 'serif' },
            arrangement: 'freeform'
        }];

        const layout = {
            margin: { t: 30, b: 20, l: 50, r: 50 },
            title: selectedColumns.join(' - '),
            font: { family: 'serif', color: theme.text },
            paper_bgcolor: theme.surface,
            plot_bgcolor: theme.surface
        };

        Plotly.newPlot('parcats-chart', data, layout, { responsive: true });
    }

    function getThemeColors() {
        const styles = getComputedStyle(document.documentElement);
        return {
            surface: styles.getPropertyValue('--surface').trim(),
            text: styles.getPropertyValue('--ink').trim(),
            line: styles.getPropertyValue('--line').trim(),
            accent: styles.getPropertyValue('--accent').trim(),
            isDark: window.matchMedia('(prefers-color-scheme: dark)').matches
        };
    }

    // Run
    init();

</script>
