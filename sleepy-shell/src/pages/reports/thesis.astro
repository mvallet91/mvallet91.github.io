---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import L from '../../components/L.astro';

const meta = {
  en: {
    title: 'Sequences in Data to Represent Learning Processes | Manuel Valle Torre',
    description: 'An interactive thesis showcase about making learning processes visible in the age of AI.'
  },
  es: {
    title: 'Secuencias en datos para representar procesos de aprendizaje | Manuel Valle Torre',
    description: 'Una muestra interactiva de tesis sobre cómo hacer visibles los procesos de aprendizaje en la era de la IA.'
  }
};

const phases = [
  {
    id: 'analyze',
    number: '01',
    label: { en: 'Analyze', es: 'Analizar' },
    title: { en: 'Make the process visible', es: 'Hacer visible el proceso' },
    text: {
      en: 'The first task is to look beyond final products. Sequence analysis can reveal the structure and fine-grained actions of problem solving, but static artifacts still conceal the trial-and-error that produces them.',
      es: 'La primera tarea es mirar más allá de los productos finales. El análisis de secuencias puede revelar la estructura y las acciones detalladas de la resolución de problemas, pero los artefactos estáticos siguen ocultando el ensayo y error que los produce.'
    },
    color: 'amber'
  },
  {
    id: 'understand',
    number: '02',
    label: { en: 'Understand', es: 'Comprender' },
    title: { en: 'Turn traces into context', es: 'Convertir rastros en contexto' },
    text: {
      en: 'Fine-grained, real-time telemetry makes it possible to understand what a learner has tried—not only whether an answer is correct. JELAI couples those traces with conversational tutoring inside the learning environment.',
      es: 'La telemetría detallada y en tiempo real permite entender lo que un estudiante ha intentado, no solo si una respuesta es correcta. JELAI combina esos rastros con tutoría conversacional dentro del propio entorno de aprendizaje.'
    },
    color: 'emerald'
  },
  {
    id: 'support',
    number: '03',
    label: { en: 'Support', es: 'Apoyar' },
    title: { en: 'Scaffold the next step', es: 'Andamiar el siguiente paso' },
    text: {
      en: 'When AI can generate a final product instantly, the crucial design question is how it shapes learning. The final studies examine interventions that encourage productive inquiry while accounting for different learner needs.',
      es: 'Cuando la IA puede generar un producto final al instante, la pregunta de diseño clave es cómo moldea el aprendizaje. Los últimos estudios examinan intervenciones que fomentan la indagación productiva y toman en cuenta las distintas necesidades de los estudiantes.'
    },
    color: 'orange'
  }
];

// Paper titles stay in English: they are the published titles.
const papers = [
  {
    chapter: 2,
    phase: 'analyze',
    title: 'EdX Log Data Analysis Made Easy: Introducing ELAT',
    venue: 'LAK 2020',
    href: '/assets/publications/LAK2020-ELAT.pdf',
    detail: {
      en: 'Sequence and process visualization for MOOC logs at scale.',
      es: 'Visualización de secuencias y procesos para registros de MOOC a gran escala.'
    }
  },
  {
    chapter: 3,
    phase: 'analyze',
    title: 'The Sequence Matters in Learning',
    venue: 'LAK 2024',
    href: '/assets/publications/LAK24_Sequence.pdf',
    detail: {
      en: 'A systematic review identifying the gap between analysis and real-time intervention.',
      es: 'Una revisión sistemática que identifica la brecha entre el análisis y la intervención en tiempo real.'
    }
  },
  {
    chapter: 4,
    phase: 'analyze',
    title: 'What makes an Expert?',
    venue: 'arXiv 2026',
    href: 'https://arxiv.org/abs/2602.15428',
    detail: {
      en: 'Comparing problem-solving practices in data science notebooks.',
      es: 'Comparación de prácticas de resolución de problemas en notebooks de ciencia de datos.'
    }
  },
  {
    chapter: 5,
    phase: 'understand',
    title: 'JELAI: Integrating AI and Learning Analytics in Jupyter Notebooks',
    venue: 'AIED 2025',
    href: '/assets/publications/AIED2025-JELAI.pdf',
    detail: {
      en: 'An architecture for context-aware tutoring and fine-grained learning analytics.',
      es: 'Una arquitectura para tutoría sensible al contexto y analítica del aprendizaje detallada.'
    }
  },
  {
    chapter: 6,
    phase: 'support',
    title: 'LLM Chatbots in High School Programming',
    venue: "SAC '26",
    href: '/assets/publications/ACM-SAC26-LLM.pdf',
    detail: {
      en: 'How help-seeking behavior and explicit teaching shape AI use in programming.',
      es: 'Cómo la búsqueda de ayuda y la enseñanza explícita moldean el uso de la IA en programación.'
    }
  },
  {
    chapter: 7,
    phase: 'support',
    title: 'Process Collapse or Compensatory Strategy?',
    venue: 'SSRN 2026',
    href: 'https://papers.ssrn.com/sol3/papers.cfm?abstract_id=6297817',
    detail: {
      en: 'Profiling and scaffolding help-seeking with an AI tutor.',
      es: 'Perfilar y andamiar la búsqueda de ayuda con un tutor de IA.'
    }
  }
];

const propositions = [
  {
    en: 'Thanks to Generative AI (GenAI), the quality of unsupervised artifacts—like an essay or code snippet—went from imperfect to useless as a proxy for student competence. (This thesis)',
    es: 'Gracias a la IA generativa (IAGen), la calidad de los productos elaborados sin supervisión —como un ensayo o un fragmento de código— pasó de ser un indicador imperfecto de la competencia del estudiante a uno inútil. (Esta tesis)'
  },
  {
    en: 'Unproductive help-seeking with GenAI does not self-correct over time; without explicit intervention, use of AI tools tends toward dependence rather than learning. (This thesis)',
    es: 'La búsqueda de ayuda improductiva con IAGen no se corrige sola con el tiempo; sin una intervención explícita, el uso de herramientas de IA tiende a la dependencia más que al aprendizaje. (Esta tesis)'
  },
  {
    en: 'The value of AI in education lies not in optimizing performance but in supporting the learning process: a well-timed encouragement can help more than a precise explanation. (This thesis)',
    es: 'El valor de la IA en la educación no está en optimizar el desempeño, sino en apoyar el proceso de aprendizaje: unas palabras de aliento en el momento justo pueden ayudar más que una explicación precisa. (Esta tesis)'
  },
  {
    en: 'Delegation is a valid professional strategy; education must shift from forbidding GenAI delegation to teaching students when to use it and how to formulate and verify the output of that delegation.',
    es: 'Delegar es una estrategia profesional válida; la educación debe pasar de prohibir la delegación a la IAGen a enseñar a los estudiantes cuándo recurrir a ella y cómo formular y verificar el resultado de esa delegación.'
  },
  {
    en: 'We design GenAI tutors to be conversational partners, but students use them as vending machines; pedagogical design must bridge the gap between how tools are actually used and how we imagine they should be. (This thesis)',
    es: 'Diseñamos tutores de IAGen para que sean interlocutores, pero los estudiantes los usan como máquinas expendedoras; el diseño pedagógico debe cerrar la brecha entre cómo se usan realmente las herramientas y cómo imaginamos que deberían usarse. (Esta tesis)'
  },
  {
    en: 'Learning Analytics often falls into analysis paralysis, carefully mapping the learning journey without actually intervening, while GenAI implementation is opportunistic; effective educational technology requires us to find a middle ground.',
    es: 'La analítica del aprendizaje suele caer en la parálisis por análisis, trazando con cuidado el recorrido de aprendizaje sin llegar a intervenir, mientras que la implementación de la IAGen es oportunista; una tecnología educativa eficaz nos exige encontrar un punto medio.'
  },
  {
    en: 'The view from the mountain top may be the same whether you arrive by bicycle or by car, but the joy is in the pedaling; in our rush to automate the outcome, we risk losing the pleasure of the process.',
    es: 'La vista desde la cima puede ser la misma si llegas en bicicleta o en carro, pero la alegría está en pedalear; con la prisa por automatizar el resultado, corremos el riesgo de perder el gusto por el proceso.'
  },
  {
    en: 'Educational research can no longer afford to be paralyzed by systemic inertia; to keep pace with technological change, schools, teachers, and students must become active participants in the research process.',
    es: 'La investigación educativa ya no puede darse el lujo de quedar paralizada por la inercia del sistema; para seguir el ritmo del cambio tecnológico, escuelas, docentes y estudiantes deben volverse participantes activos del proceso de investigación.'
  },
  {
    en: 'Beware of the illusion of competence: plumbing tutorials and instructions will give you the required knowledge, but only water will tell you if your installation is right.',
    es: 'Cuidado con la ilusión de competencia: los tutoriales e instructivos de plomería te darán el conocimiento necesario, pero solo el agua te dirá si tu instalación quedó bien.'
  },
  {
    en: "Writing a dissertation on `process over product' is ironic, given that the work is ultimately judged by what is captured in this book rather than the years of process.",
    es: 'Escribir una tesis sobre “el proceso por encima del producto” es irónico, dado que el trabajo se juzga, al final, por lo que queda plasmado en este libro y no por los años de proceso.'
  }
];

const coverAlt = {
  en: 'Cover of Sequences in Data to Represent Learning Processes',
  es: 'Portada de Secuencias en datos para representar procesos de aprendizaje'
};
---

<Layout title={meta.en.title} description={meta.en.description}>
  <Fragment slot="head">
    <script is:inline define:vars={{ meta }}>
      // Pick the language before first paint to avoid a flash of English.
      (function () {
        var lang = 'en';
        try {
          var param = new URLSearchParams(location.search).get('lang');
          var saved = localStorage.getItem('thesis-lang');
          lang = (param || saved) === 'es' ? 'es' : 'en';
        } catch (e) {}
        document.documentElement.dataset.lang = lang;
        document.documentElement.lang = lang;
        document.title = meta[lang].title;
      })();
    </script>
    <style is:global>
      html:not([data-lang='es']) .lang-es,
      html[data-lang='es'] .lang-en {
        display: none !important;
      }
      .lang-btn[aria-pressed='true'] {
        background: #b45309;
        border-color: #b45309;
        color: #fff;
      }
    </style>
  </Fragment>

  <Header slot="header" />

  <main class="max-w-5xl mx-auto px-6 py-12 space-y-20">
    <div class="flex justify-end -mb-12 md:-mb-14">
      <div class="inline-flex border-2 border-gray-900 dark:border-gray-100" role="group" aria-label="Language / Idioma">
        <button type="button" class="lang-btn flex items-center gap-2 px-3 py-2 font-analog-mono text-xs font-bold uppercase tracking-wider text-gray-800 dark:text-gray-200 hover:bg-amber-100 dark:hover:bg-amber-900/40 transition-colors" data-set-lang="en" aria-pressed="true" title="English" lang="en">
          <svg viewBox="0 0 60 30" width="24" height="12" aria-hidden="true" class="shrink-0 ring-1 ring-black/20">
            <clipPath id="uk-flag-clip"><path d="M30,15 h30 v15 z v15 h-30 z h-30 v-15 z v-15 h30 z" /></clipPath>
            <path d="M0,0 v30 h60 v-30 z" fill="#012169" />
            <path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6" />
            <path d="M0,0 L60,30 M60,0 L0,30" clip-path="url(#uk-flag-clip)" stroke="#C8102E" stroke-width="4" />
            <path d="M30,0 v30 M0,15 h60" stroke="#fff" stroke-width="10" />
            <path d="M30,0 v30 M0,15 h60" stroke="#C8102E" stroke-width="6" />
          </svg>
          EN
        </button>
        <button type="button" class="lang-btn flex items-center gap-2 px-3 py-2 border-l-2 border-gray-900 dark:border-gray-100 font-analog-mono text-xs font-bold uppercase tracking-wider text-gray-800 dark:text-gray-200 hover:bg-amber-100 dark:hover:bg-amber-900/40 transition-colors" data-set-lang="es" aria-pressed="false" title="Español" lang="es">
          <svg viewBox="0 0 21 12" width="21" height="12" aria-hidden="true" class="shrink-0 ring-1 ring-black/20">
            <rect width="7" height="12" fill="#006847" />
            <rect x="7" width="7" height="12" fill="#fff" />
            <rect x="14" width="7" height="12" fill="#CE1126" />
            <ellipse cx="10.5" cy="6" rx="1.7" ry="2" fill="#8C5A2B" />
            <path d="M8.6,7.6 Q10.5,9.4 12.4,7.6" stroke="#006847" stroke-width="0.7" fill="none" />
          </svg>
          ES
        </button>
      </div>
    </div>

    <section class="grid md:grid-cols-[230px,1fr] gap-10 items-start">
      <a href="/assets/publications/Dissertation-MVT.pdf" target="_blank" rel="noopener noreferrer" class="block group md:sticky md:top-8">
        <img src="/assets/img/ThesisCoverFront-web.jpg" alt={coverAlt.en} data-alt-en={coverAlt.en} data-alt-es={coverAlt.es} width="700" height="1004" loading="eager" class="w-full max-w-[230px] mx-auto shadow-xl transition-transform duration-300 group-hover:-translate-y-2" />
        <span class="mt-4 block text-center font-analog-mono text-xs font-bold uppercase tracking-wider text-gray-700 dark:text-gray-300 group-hover:underline"><L en="Open dissertation [PDF] ↗" es="Abrir tesis [PDF] ↗" /></span>
      </a>

      <div class="pt-2">
        <p class="font-analog-mono text-xs uppercase tracking-widest text-amber-700 dark:text-amber-400 mb-5"><L en="Thesis Showcase // TU Delft // 2026" es="Muestra de tesis // TU Delft // 2026" /></p>
        <h1 class="text-5xl md:text-7xl font-analog-serif font-black tracking-tighter text-black dark:text-white leading-[0.9]"><L en="Sequences in Data to Represent Learning Processes" es="Secuencias en datos para representar procesos de aprendizaje" /></h1>
        <p class="mt-5 font-analog-serif text-xl text-gray-700 dark:text-gray-300 italic">Manuel Valle Torre</p>
        <div class="mt-8 border-l-4 border-amber-600 pl-6 font-analog-serif text-xl md:text-2xl leading-relaxed text-gray-800 dark:text-gray-200">
          <p><L
            en="For a maguey to produce a towering quiote—or to be harvested for mezcal—its growth must happen in the right order and over the right amount of time. If this long, and mostly invisible, process is short-circuited, the output lacks substance. The same is true for learning."
            es="Para que un maguey produzca un quiote imponente —o para que se pueda cosechar para hacer mezcal—, su crecimiento debe darse en el orden correcto y durante el tiempo necesario. Si se toman atajos en este proceso largo y casi siempre invisible, el resultado carece de sustancia. Lo mismo pasa con el aprendizaje."
          /></p>
        </div>
      </div>
    </section>

    <section class="bg-amber-50 dark:bg-amber-950/20 border border-amber-200 dark:border-amber-900 rounded-2xl p-8 md:p-12">
      <div class="max-w-3xl mx-auto text-center">
        <p class="font-analog-mono text-xs uppercase tracking-widest text-amber-800 dark:text-amber-300"><L en="The problem" es="El problema" /></p>
        <h2 class="mt-3 text-3xl md:text-5xl font-analog-serif font-bold text-gray-900 dark:text-white"><L en="A polished product can hide an unfinished process." es="Un producto pulido puede esconder un proceso inacabado." /></h2>
        <p class="mt-6 font-analog-serif text-lg leading-relaxed text-gray-700 dark:text-gray-300"><L
          en="With the popularization of AI, both a novice delegating all the work and a more experienced hard worker can generate identical results in seconds; the final product is no longer a reliable measure of competence. However, we have the tools to make students' learning processes visible and be able to support them in real time."
          es="Con la popularización de la IA, tanto un principiante que delega todo el trabajo como alguien con más experiencia que trabaja con esmero pueden generar resultados idénticos en segundos; el producto final ya no es una medida confiable de la competencia. Sin embargo, contamos con las herramientas para hacer visibles los procesos de aprendizaje de los estudiantes y apoyarlos en tiempo real."
        /></p>
      </div>
    </section>

    <section aria-labelledby="journey-title">
      <div class="text-center max-w-3xl mx-auto">
        <p class="font-analog-mono text-xs uppercase tracking-widest text-gray-500"><L en="Interactive research journey" es="Recorrido interactivo por la investigación" /></p>
        <h2 id="journey-title" class="mt-3 text-4xl md:text-5xl font-analog-serif font-bold text-black dark:text-white"><L en="Follow the growth cycle" es="Sigue el ciclo de crecimiento" /></h2>
        <p class="mt-4 font-analog-serif text-lg text-gray-700 dark:text-gray-300"><L
          en="Select a phase to trace how the work moves from observing learning sequences to supporting learners while they work."
          es="Selecciona una fase para ver cómo el trabajo avanza de observar secuencias de aprendizaje a apoyar a los estudiantes mientras trabajan."
        /></p>
      </div>

      <div class="mt-10 grid md:grid-cols-3 gap-3" role="tablist" aria-label="Research phases" data-aria-label-en="Research phases" data-aria-label-es="Fases de la investigación">
        {phases.map((phase, index) => (
          <button type="button" class={`phase-tab text-left p-5 border-2 transition-colors ${index === 0 ? 'bg-amber-700 border-amber-700 text-white' : 'border-gray-300 dark:border-gray-700 hover:border-amber-600 text-gray-800 dark:text-gray-200'}`} data-phase={phase.id} role="tab" aria-selected={index === 0 ? 'true' : 'false'}>
            <span class="font-analog-mono text-xs opacity-80"><L en={`PHASE ${phase.number}`} es={`FASE ${phase.number}`} /></span>
            <span class="block mt-1 font-analog-serif text-2xl font-bold"><L en={phase.label.en} es={phase.label.es} /></span>
          </button>
        ))}
      </div>

      <div class="mt-5 border-2 border-gray-900 dark:border-gray-100 p-7 md:p-10">
        {phases.map((phase, index) => (
          <div class:list={["phase-panel", index !== 0 && "hidden"]} data-panel={phase.id} role="tabpanel">
            <p class="font-analog-mono text-xs uppercase tracking-widest text-amber-700 dark:text-amber-400"><L en={`Phase ${phase.number}: ${phase.label.en}`} es={`Fase ${phase.number}: ${phase.label.es}`} /></p>
            <h3 class="mt-2 text-3xl font-analog-serif font-bold text-black dark:text-white"><L en={phase.title.en} es={phase.title.es} /></h3>
            <p class="mt-4 max-w-3xl font-analog-serif text-lg leading-relaxed text-gray-700 dark:text-gray-300"><L en={phase.text.en} es={phase.text.es} /></p>
            <div class="mt-7 grid sm:grid-cols-2 gap-4">
              {papers.filter((paper) => paper.phase === phase.id).map((paper) => (
                <a href={paper.href} target="_blank" rel="noopener noreferrer" class="group block bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 p-5 hover:border-amber-600 dark:hover:border-amber-400 transition-colors">
                  <span class="font-analog-mono text-xs text-gray-500"><L en={`Chapter ${paper.chapter}`} es={`Capítulo ${paper.chapter}`} /> // {paper.venue}</span>
                  <h4 class="mt-2 font-analog-serif text-xl font-bold text-black dark:text-white group-hover:underline" lang="en">{paper.title} ↗</h4>
                  <p class="mt-2 font-analog-serif text-sm text-gray-600 dark:text-gray-400"><L en={paper.detail.en} es={paper.detail.es} /></p>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section aria-labelledby="propositions-title" class="border-y-2 border-dashed border-gray-300 dark:border-gray-700 py-14">
      <div class="max-w-3xl">
        <p class="font-analog-mono text-xs uppercase tracking-widest text-amber-700 dark:text-amber-400"><L en="Propositions" es="Proposiciones" /></p>
        <h2 id="propositions-title" class="mt-3 text-4xl md:text-5xl font-analog-serif font-bold text-black dark:text-white"><L en="Ten positions on process, AI, and learning." es="Diez posturas sobre el proceso, la IA y el aprendizaje." /></h2>
      </div>
      <ol class="mt-10 grid md:grid-cols-2 gap-4 list-none p-0">
        {propositions.map((proposition, index) => (
          <li class="group border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 p-6 transition-colors hover:border-amber-600 dark:hover:border-amber-400">
            <span class="font-analog-mono text-sm font-bold text-amber-700 dark:text-amber-400">{(index + 1).toString().padStart(2, '0')}</span>
            <p class="mt-4 font-analog-serif text-lg leading-relaxed text-gray-800 dark:text-gray-200"><L en={proposition.en} es={proposition.es} /></p>
          </li>
        ))}
      </ol>
    </section>

    <section class="grid md:grid-cols-[1fr,280px] gap-10 items-center border-y-2 border-dashed border-gray-300 dark:border-gray-700 py-14">
      <div>
        <p class="font-analog-mono text-xs uppercase tracking-widest text-amber-700 dark:text-amber-400"><L en="The contribution" es="La contribución" /></p>
        <h2 class="mt-3 text-4xl font-analog-serif font-bold text-black dark:text-white"><L en="From data to learning." es="De los datos al aprendizaje." /></h2>
        <p class="mt-5 font-analog-serif text-lg leading-relaxed text-gray-700 dark:text-gray-300"><L
          en="Instead of chasing flawless final products, this dissertation explores how we can use data to uncover the learning process as it happens. It investigates practical ways to deploy real-time conversational interventions, showing how sequence-driven scaffolding can nudge students in the right direction and prevent them from treating AI as a solution vending machine."
          es="En lugar de perseguir productos finales impecables, esta tesis explora cómo podemos usar los datos para descubrir el proceso de aprendizaje mientras ocurre. Investiga formas prácticas de implementar intervenciones conversacionales en tiempo real y muestra cómo un andamiaje basado en secuencias puede orientar a los estudiantes en la dirección correcta y evitar que traten a la IA como una máquina expendedora de soluciones."
        /></p>
      </div>
      <a href="/assets/publications/Dissertation-MVT.pdf" target="_blank" rel="noopener noreferrer" class="block text-center border-2 border-black dark:border-white py-4 px-5 font-analog-mono text-sm font-bold uppercase hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black transition-colors"><L en="Read the full dissertation →" es="Lee la tesis completa →" /></a>
    </section>
  </main>

  <script define:vars={{ meta }}>
    // Language toggle
    const langButtons = document.querySelectorAll('[data-set-lang]');
    const descriptionTag = document.querySelector('meta[name="description"]');

    function applyLang(lang, persist) {
      const root = document.documentElement;
      root.dataset.lang = lang;
      root.lang = lang;
      document.title = meta[lang].title;
      if (descriptionTag) descriptionTag.setAttribute('content', meta[lang].description);
      langButtons.forEach((btn) => btn.setAttribute('aria-pressed', String(btn.dataset.setLang === lang)));
      document.querySelectorAll('[data-alt-en]').forEach((el) => el.setAttribute('alt', el.dataset[lang === 'es' ? 'altEs' : 'altEn']));
      document.querySelectorAll('[data-aria-label-en]').forEach((el) => el.setAttribute('aria-label', el.dataset[lang === 'es' ? 'ariaLabelEs' : 'ariaLabelEn']));
      if (persist) {
        try { localStorage.setItem('thesis-lang', lang); } catch (e) {}
        const url = new URL(location.href);
        if (lang === 'es') url.searchParams.set('lang', 'es');
        else url.searchParams.delete('lang');
        history.replaceState(null, '', url);
      }
    }

    langButtons.forEach((btn) => btn.addEventListener('click', () => applyLang(btn.dataset.setLang, true)));
    applyLang(document.documentElement.dataset.lang === 'es' ? 'es' : 'en', false);

    // Phase tabs
    const tabs = document.querySelectorAll('.phase-tab');
    const panels = document.querySelectorAll('.phase-panel');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const phase = tab.dataset.phase;
        tabs.forEach((item) => {
          const active = item.dataset.phase === phase;
          item.setAttribute('aria-selected', String(active));
          item.classList.toggle('bg-amber-700', active);
          item.classList.toggle('border-amber-700', active);
          item.classList.toggle('text-white', active);
          item.classList.toggle('border-gray-300', !active);
          item.classList.toggle('dark:border-gray-700', !active);
          item.classList.toggle('text-gray-800', !active);
          item.classList.toggle('dark:text-gray-200', !active);
        });
        panels.forEach((panel) => panel.classList.toggle('hidden', panel.dataset.panel !== phase));
      });
    });
  </script>
</Layout>
