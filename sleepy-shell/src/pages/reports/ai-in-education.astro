---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import reportHtml from '../../content/reports/ai-in-education.html?raw';

// Extract HEAD content (scripts, styles)
const headMatch = reportHtml.match(/<head[^>]*>([\s\S]*?)<\/head>/i);
const headContent = headMatch ? headMatch[1] : '';

// Extract BODY content
const bodyMatch = reportHtml.match(/<body[^>]*>([\s\S]*?)<\/body>/i);
let bodyContent = bodyMatch ? bodyMatch[1] : '';

// Remove the existing <header> (which contains the old nav)
bodyContent = bodyContent.replace(/<header[^>]*>[\s\S]*?<\/header>/i, '');
---

<Layout title="AI + Learning Analytics: The Missing Link in Education">
  <Fragment slot="head" set:html={headContent} />
  <Header slot="header" />
  <Fragment set:html={bodyContent} />
</Layout>
