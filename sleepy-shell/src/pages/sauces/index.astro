---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';

const sauces = await Astro.glob('./*.mdx');
const sortedSauces = sauces.sort((a, b) => {
  const aDate = a.frontmatter.pubDate ?? '1970-01-01';
  const bDate = b.frontmatter.pubDate ?? '1970-01-01';
  return new Date(`${bDate}T00:00:00Z`).getTime() - new Date(`${aDate}T00:00:00Z`).getTime();
});
---

<Layout
  title="Hot Sauces | Manuel Valle Torre"
  description="Handcrafted hot sauce recipes inspired by travel, ferments, and experimentation."
>
  <Header slot="header" />

  <main class="max-w-4xl mx-auto space-y-12 px-6 py-12">
    <section class="border-b-2 border-black dark:border-white pb-8">
      <h1 class="text-6xl font-analog-serif font-black tracking-tighter text-black dark:text-white uppercase mb-4">
        Hot Sauces
      </h1>
      <p class="text-xl font-analog-serif text-gray-800 dark:text-gray-200 max-w-2xl leading-relaxed">
        The kitchen lab. Experiments with fermentation, pH, and Scoville units.
      </p>
      <div class="mt-4 font-analog-mono text-xs uppercase text-gray-500 border border-gray-300 inline-block px-2 py-1">
        LAB_STATUS: ACTIVE_FERMENTATION
      </div>
    </section>

    <div class="space-y-2">
      <!-- Table Header -->
      <div class="hidden md:grid grid-cols-[100px,2fr,1fr,150px] gap-4 font-analog-mono text-xs font-bold uppercase border-b-2 border-black dark:border-white pb-2 mb-4">
        <div>Date</div>
        <div>Specimen Name</div>
        <div>Tags</div>
        <div>Status</div>
      </div>

      {sortedSauces.map((sauce) => (
        <article class="group relative">
           <a href={sauce.url} class="block md:grid md:grid-cols-[100px,2fr,1fr,150px] gap-4 items-center border-b border-gray-200 dark:border-gray-800 py-4 hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors">
            
            <!-- Date -->
            <div class="font-analog-mono text-xs text-gray-500 mb-2 md:mb-0">
               {sauce.frontmatter.pubDate}
            </div>

            <!-- Name & Desc -->
            <div class="pr-4">
               <h2 class="text-2xl font-analog-serif font-bold text-black dark:text-white leading-none group-hover:underline decoration-2">
                 {sauce.frontmatter.title}
               </h2>
               {sauce.frontmatter.subtitle && (
                 <p class="font-analog-serif text-gray-600 text-sm mt-1 italic">
                   {sauce.frontmatter.subtitle}
                 </p>
               )}
            </div>

            <!-- Tags -->
            <div class="flex flex-wrap gap-2 mb-2 md:mb-0">
               {(sauce.frontmatter.tags ?? []).map((tag) => (
                  <span class="font-analog-mono text-[10px] border border-gray-400 px-1 uppercase">{tag}</span>
               ))}
            </div>

            <!-- Action -->
            <div class="text-right md:text-left">
               <span class="font-analog-mono text-xs font-bold bg-black text-white px-2 py-1 invisible group-hover:visible">
                 VIEW_LOG ->
               </span>
            </div>

           </a>
        </article>
      ))}
    </div>
  </main>
</Layout>
